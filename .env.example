# ==================== CẤU HÌNH MONGODB ====================
# Chuỗi kết nối MongoDB Atlas
# Copy từ MongoDB Atlas: Cluster -> Connect -> Connect your application
# VD: mongodb+srv://username:password@cluster.mongodb.net/?appName=yourapp
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=webxemphim

# ==================== CẤU HÌNH JWT ====================
# Key để mã hóa JWT token - THAY BẰNG MỘT CHUỖI NGẪU NHIÊN CHỨA CẢ SỐ, CHỮ, KÍ TỰ ĐẶC BIỆT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
# Thời gian Access Token hết hạn (15m = 15 phút - token ngắn hạn để bảo mật)
ACCESS_TOKEN_EXPIRE=15m
# Thời gian Refresh Token hết hạn (30d = 30 ngày - token dài hạn để renew)
REFRESH_TOKEN_EXPIRE=30d
# JWT_EXPIRE (giữ lại cho backwards compatibility, không dùng nữa)
JWT_EXPIRE=7d

# ==================== CẤU HÌNH SERVER ====================
# Port chạy server
PORT=5000
# Môi trường (development/production)
NODE_ENV=development

# ==================== CẤU HÌNH CLOUDINARY (Upload ảnh/video) ====================
# Lấy từ https://cloudinary.com/console/settings/api-keys
# CLOUDINARY_NAME: Cloud name từ Cloudinary
# CLOUDINARY_API_KEY: API Key từ Cloudinary
# CLOUDINARY_API_SECRET: API Secret từ Cloudinary (GIỮ BẢO MẬT!)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== CẤU HÌNH EMAIL (Tùy chọn - dùng trong tương lai) ====================
# Dùng để gửi email xác nhận đăng ký, đặt lại mật khẩu, v.v.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

SMTP_FROM_EMAIL=
SMTP_FROM_PASSWORD=

# ==================== CẤU HÌNH ADMIN ====================
# Email tài khoản admin mặc định
ADMIN_EMAIL=admin@webxemphim.com
# Password admin mặc định
ADMIN_PASSWORD=admin123456

# ==================== CẤU HÌNH GOOGLE OAUTH ====================
# Lấy từ: https://console.cloud.google.com/apis/credentials
# Redirect URIs phải chứa URL này (set tại Google Console):
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==================== CẤU HÌNH FRONTEND (CORS) ====================
# URL của frontend để cho phép request từ frontend
FRONTEND_URL=http://localhost:8000

# ==================== CẤU HÌNH REDIS (Caching) ====================
# URL kết nối Redis
# Local: redis://localhost:6379
# Cloud (Redis Labs, Upstash): redis://username:password@host:port
REDIS_URL=redis://localhost:6379
# Password Redis (nếu có, để trống nếu không có password)
REDIS_PASSWORD=
# Thời gian cache mặc định (giây) - 300s = 5 phút
REDIS_TTL=300
